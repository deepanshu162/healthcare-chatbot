# ==============================================================================
# HealthAI v0.1 — Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for AI responses)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name
# Recommended models: gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.7-flash
GEMINI_MODEL=gemini-3.6-flash

# Server Configuration
HOST=127.0.0.1
PORT=8000
