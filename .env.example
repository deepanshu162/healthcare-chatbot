# ==============================================================================
# HealthAI v0.1 — Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for AI responses)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name
# Recommended models: gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.7-flash
GEMINI_MODEL=gemini-3.6-flash

# Server Configuration
HOST=127.0.0.1
PORT=8000

# ==============================================================================
# Database Configuration (MongoDB / MongoDB Atlas)
# ==============================================================================
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=healthai

# ==============================================================================
# Authentication & Security (JWT)
# ==============================================================================
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
